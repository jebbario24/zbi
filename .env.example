# ============================================
# EatOut Restaurant Management Platform
# Environment Variables Configuration
# ============================================

# ============================================
# DATABASE (Required)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database
# Example: postgresql://eatout:password123@dpg-xyz.oregon-postgres.render.com/eatout_db

# ============================================
# SESSION (Required)
# ============================================
SESSION_SECRET=your_random_session_secret_here_minimum_32_characters
# Generate with: openssl rand -base64 32

# ============================================
# CLOUDFLARE R2 STORAGE (Required)
# ============================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket.r2.dev
PRIVATE_OBJECT_DIR=private

# How to get these:
# 1. Go to Cloudflare Dashboard → R2
# 2. Create a bucket (e.g., "eatout-storage")
# 3. R2_ACCOUNT_ID is shown in the R2 overview
# 4. Create API token: R2 → Manage R2 API Tokens → Create
# 5. R2_PUBLIC_URL: Enable public access in bucket settings

# ============================================
# SERVER CONFIGURATION (Required)
# ============================================
PORT=5000
NODE_ENV=production
BASE_URL=https://etitout.onrender.com
# BASE_URL is used for OAuth redirects, email links, etc.

# ============================================
# STRIPE PAYMENTS (Recommended)
# ============================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_subscription_price_id

# How to get these:
# 1. Go to Stripe Dashboard → Developers → API Keys
# 2. Copy Secret key (starts with sk_) and Publishable key (pk_)
# 3. Webhook secret: Developers → Webhooks → Add endpoint
#    URL: https://your-domain.com/api/webhooks/stripe
#    Events: customer.subscription.created, customer.subscription.updated, etc.
# 4. Price ID: Products → Your subscription → Pricing → Copy price ID

# ============================================
# PAYPAL PAYMENTS (Optional)
# ============================================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# How to get these:
# 1. Go to PayPal Developer Dashboard
# 2. Create an app or use existing app
# 3. Copy Client ID and Secret from app credentials

# ============================================
# GOOGLE OAUTH (Optional)
# ============================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# How to get these:
# 1. Go to Google Cloud Console
# 2. Create OAuth 2.0 credentials
# 3. Add authorized redirect URIs:
#    - https://your-domain.com/api/auth/google/callback
#    - https://your-domain.com/api/auth/google/driver/callback

# ============================================
# LOGGING (Optional)
# ============================================
LOG_LEVEL=info
# Options: error, warn, info, http, verbose, debug, silly

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Use these for local development only
# DATABASE_URL=postgresql://localhost:5432/eatout_dev
# BASE_URL=http://localhost:5000
# NODE_ENV=development

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. NEVER commit this file with real values to git
# 2. Generate strong random strings for SECRET values
# 3. Use production keys only in production environment
# 4. Test with Stripe/PayPal sandbox keys first
# 5. Set BASE_URL to your actual domain in production
# 6. Enable R2 public access for image viewing
# 7. Configure CORS on R2 bucket for file uploads
